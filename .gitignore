# What this Cargo workspace and its tasks produce, plus local tool state.
# Keep it to paths that exist here; a rule for a tool CAO does not use only
# hides files someone meant to commit.

# Cargo build output, including the tests' scratch trees under target/tmp and
# the folders `cargo xtask dist` lays out under target/dist.
/target/

# hkxcmd.exe, the third-party Animation converter. The README has each
# developer download it to bin/hkxcmd.exe, where `cargo xtask dev` and
# `cargo xtask dist` look for it, and it is never committed.
/bin/

# Claude Code agent worktrees: each is a separate checkout, so tracking them
# records gitlinks (no .gitmodules) that make every fetch recurse into them
/.claude/worktrees/
# Agents' scratch notes. Issues and specs live in GitHub Issues
# (docs/agents/issue-tracker.md); anything worth keeping moves under docs/.
/.claude/scratch/
/.scratch/
# Per-user tool configuration and indexes.
/.claude/settings.json
/.codex/hooks.json
/.codegraph/
/graphify-out/

# Per-user editor and IDE settings.
/.idea/
/CAO.code-workspace

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/CAO/verification/schemas/setup-replay-fixture.schema.json",
  "title": "Tracetide non-parity setup replay fixture",
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "operation", "kind", "subject", "diagnostic"],
      "properties": {
        "port": { "type": "string", "enum": ["portable-state", "application-runtime"] },
        "operation": { "type": "string", "enum": ["open", "load-setup", "persist-setup", "migrate-state", "restore-global-state", "reset-global-state", "start-supervisor", "stop-supervisor"] },
        "kind": { "type": "string", "enum": ["invalid-input", "unsupported", "unavailable", "not-found", "permission-denied", "conflict", "resource-exhausted", "corrupt-data", "io", "protocol", "backend-rejected", "backend-crashed", "integrity", "internal"] },
        "subject": { "type": ["string", "null"] },
        "diagnostic": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "fixture_path", "failure"],
      "properties": {
        "point": { "type": "string", "enum": ["open", "load-setup", "persist-setup", "restore-global-state", "reset-global-state"] },
        "fixture_path": { "type": "string", "const": "setup.state" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "initial_state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "dry_run"],
          "properties": {
            "status": { "const": "ready" },
            "dry_run": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "recovered_dry_run", "backup_available", "failure"],
          "properties": {
            "status": { "const": "recovery-required" },
            "recovered_dry_run": { "type": "boolean" },
            "backup_available": { "type": "boolean" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        }
      ]
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dry_run"],
          "properties": {
            "kind": { "const": "edit-profile-overlay" },
            "dry_run": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "recover-global-state" },
            "action": { "type": "string", "enum": ["restore-backup", "reset"] }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initial_state", "intent", "fault"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "initial_state": { "$ref": "#/$defs/initial_state" },
        "intent": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/intent" }] },
        "fault": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fault" }] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_revision", "id", "revision", "cases"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "baseline_revision": { "type": "integer", "const": 2 },
    "id": { "type": "string", "const": "SETUP-SEAM-FIXTURE" },
    "revision": { "type": "integer", "const": 1 },
    "cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/case" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/CAO/verification/schemas/discrepancy-register.schema.json",
  "title": "Tracetide discrepancy register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_revision", "register_revision", "entries"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "baseline_revision": { "type": "integer", "const": 2 },
    "register_revision": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "status",
          "classification",
          "rationale",
          "oracle_evidence_refs",
          "affected",
          "risk",
          "replacement_behavior",
          "automated_regression_evidence",
          "manual_evidence",
          "approval"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^DISC-[0-9]{4}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["Proposed", "Approved", "Rejected", "Superseded"] },
          "classification": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "oracle_evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Z0-9-]+@[1-9][0-9]*$" } },
          "affected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["games", "profiles", "options", "inputs", "operations", "outputs", "workflows"],
            "properties": {
              "games": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "workflows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compatibility", "data_integrity", "migration"],
            "properties": {
              "compatibility": { "type": "string", "minLength": 1 },
              "data_integrity": { "type": "string", "minLength": 1 },
              "migration": { "type": "string", "minLength": 1 }
            }
          },
          "replacement_behavior": { "type": "string", "minLength": 1 },
          "automated_regression_evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Z0-9-]+@[1-9][0-9]*$" } },
          "manual_evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Z0-9-]+@[1-9][0-9]*$" } },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maintainer", "decided_on", "superseded_by"],
            "properties": {
              "maintainer": { "type": ["string", "null"] },
              "decided_on": { "type": ["string", "null"], "format": "date" },
              "superseded_by": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}

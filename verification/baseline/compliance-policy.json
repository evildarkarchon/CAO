{
  "schema_version": 2,
  "baseline_revision": 2,
  "authority": "docs/rust-slint-implementation-blueprint.md",
  "licensing": {
    "combined_work": "GPL-3.0-only",
    "slint_choice": "GPL-3.0-only",
    "existing_source_files": "preserve-MPL-2.0-coverage-and-notices",
    "corresponding_source": "exact-source-alongside-every-binary"
  },
  "native_runtime": {
    "scope": "tracetide-production-graph",

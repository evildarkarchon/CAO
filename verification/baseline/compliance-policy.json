    "msvc_flag": "/MD",
    "rust_crt_linkage": "dynamic",
    "debug_crt_allowed": false
  },
  "windows": {
    "minimum_release": "Windows 10 22H2",
    "minimum_architecture": "x86_64",
    "minimum_support_status": "out-of-support",
    "primary_release": "Windows 11 x64",
    "cpu_baseline": "x86-64",
    "avx_required": false,
    "avx2_required": false
  }

# Oracle transcripts are captured stdout, CRLF line endings included. The
# cao-parity parser tests read them byte for byte, so git must never convert them.
crates/cao-parity/tests/transcripts/** -text
# INI fixtures are bytes Qt 5.15 wrote or read (CRLF, Latin-1 and trailing spaces
# included). The cao-profiles tests compare them byte for byte.
crates/cao-profiles/tests/fixtures/qt-written/** -text
crates/cao-profiles/tests/fixtures/qt-read/** -text
# nifly's own NIF fixtures, vendored at the pin. The nifly-sys tests compare each
# saved Mesh with its `_expected.nif` byte for byte.
crates/nifly-sys/vendor/nifly/tests/*.nif binary
# CAO-STAGING manifests, two of them written by the C++ oracle. The staging recovery
# tests reuse every byte but the Mod Root line, so git must never convert them.
crates/cao-core/tests/fixtures/staging/*.manifest -text

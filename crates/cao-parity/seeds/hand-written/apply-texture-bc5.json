{
  "spec": {
    "profile": "SSE",
    "mod_selection": {
      "kind": "one_mod",
      "folder": "mods/NormalMod"
    },
    "dry_run": false,
    "textures": {
      "necessary": true,
      "compress": true,
      "mipmaps": true,
      "resize_by_ratio": false,
      "ratio_width": 1,
      "ratio_height": 1,
      "resize_by_size": false,
      "target_width": 2048,
      "target_height": 2048
    },
    "meshes": {
      "level": 0,
      "headparts": false,
      "resave": false
    },
    "animations": false,
    "archives": {
      "extract": false,
      "create": false,
      "delete_backup": false,
      "compress": true,
      "create_dummies": true,
      "merge_incompressible": true,
      "merge_textures": false,
      "delete_sources": true
    }
  },
  "profile_overrides": {
    "output_format": "BC5_UNORM"
  },
  "tree": {
    "content": [
      {
        "kind": "texture",
        "path": "mods/NormalMod/textures/rock_n.dds",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64,
        "pattern": "normal",
        "note": "The BC5 output format (#494): mipmapped and compressed on the CPU in both builds, so the bytes match."
      },
      {
        "kind": "texture",
        "path": "mods/NormalMod/textures/wall_n.dds",
        "format": "B8G8R8A8_UNORM",
        "width": 32,
        "height": 64,
        "mip_levels": 0,
        "pattern": "normal",
        "note": "A full chain already: compressed to BC5 only."
      },
      {
        "kind": "texture",
        "path": "mods/NormalMod/textures/old_n.dds",
        "format": "BC3_UNORM",
        "width": 32,
        "height": 32,
        "pattern": "normal",
        "note": "Compressed already, so it keeps BC3: decompressed, mipmapped and compressed back."
      }
    ]
  }
}

{
  "spec": {
    "profile": "SSE",
    "mod_selection": {
      "kind": "one_mod",
      "folder": "mods/ReferenceMod"
    },
    "dry_run": false,
    "textures": {
      "necessary": true,
      "compress": false,
      "mipmaps": false,
      "resize_by_ratio": false,
      "ratio_width": 1,
      "ratio_height": 1,
      "resize_by_size": false,
      "target_width": 2048,
      "target_height": 2048
    },
    "meshes": {
      "level": 0,
      "headparts": true,
      "resave": false
    },
    "animations": false,
    "archives": {
      "extract": false,
      "create": false,
      "delete_backup": false,
      "compress": true,
      "create_dummies": true,
      "merge_incompressible": true,
      "merge_textures": false,
      "delete_sources": true
    }
  },
  "profile_overrides": {
    "output_format": "BC1_UNORM"
  },
  "tree": {
    "content": [
      {
        "kind": "texture",
        "path": "mods/ReferenceMod/textures/armor/body.tga",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64,
        "note": "Mesh Reference Maintenance (#506): SSE converts TGAs, so necessary optimization alone converts this to body.dds, compressed to BC1 so the DDS is byte-equal, and deletes the TGA."
      },
      {
        "kind": "texture",
        "path": "mods/ReferenceMod/textures/armor/trim.tga",
        "format": "R8G8B8A8_UNORM",
        "width": 32,
        "height": 32,
        "pattern": "alpha_ramp",
        "note": "A second converted TGA, which body.nif names in mixed case."
      },
      {
        "kind": "mesh",
        "path": "mods/ReferenceMod/meshes/armor/body.nif",
        "version": "sse",
        "shapes": [
          {
            "name": "Body",
            "textures": [
              "textures\\armor\\body.tga",
              "textures\\armor\\body_n.dds"
            ]
          },
          {
            "name": "Trim",
            "textures": [
              "textures\\armor\\TRIM.TgA"
            ]
          }
        ],
        "note": "References both converted TGAs: both builds rewrite each .tga, whatever its case, to .dds and save it. Mesh optimization is off, so this is the only reason it is written."
      },
      {
        "kind": "mesh",
        "path": "mods/ReferenceMod/meshes/armor/plain.nif",
        "version": "sse",
        "shapes": [
          {
            "name": "Plain",
            "textures": [
              "textures\\armor\\plain.dds"
            ]
          }
        ],
        "note": "References no TGA, so it is left byte-for-byte alone."
      },
      {
        "kind": "mesh",
        "path": "mods/ReferenceMod/meshes/armor/elsewhere.nif",
        "version": "sse",
        "shapes": [
          {
            "name": "Elsewhere",
            "textures": [
              "textures\\vanilla\\iron.tga"
            ]
          }
        ],
        "note": "Names a TGA outside the Mod Root. C++ rewrites every TGA reference whose own conversion did not fail, so both builds rewrite this one too."
      },
      {
        "kind": "mesh",
        "path": "mods/ReferenceMod/meshes/armor/folder.nif",
        "version": "sse",
        "shapes": [
          {
            "name": "Folder",
            "textures": [
              "textures\\odd.TGA\\odd.dds"
            ]
          }
        ],
        "note": "Ported as-is: C++ matches .tga anywhere in a name, not only as its suffix, so both builds rewrite this to textures\\odd.dds\\odd.dds."
      }
    ]
  }
}

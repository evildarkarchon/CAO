{
  "spec": {
    "profile": "SSE",
    "mod_selection": {
      "kind": "one_mod",
      "folder": "mods/Mod"
    },
    "dry_run": false,
    "textures": {
      "necessary": true,
      "compress": true,
      "mipmaps": false,
      "resize_by_ratio": false,
      "ratio_width": 2,
      "ratio_height": 2,
      "resize_by_size": false,
      "target_width": 256,
      "target_height": 256
    },
    "meshes": {
      "level": 0,
      "headparts": false,
      "resave": false
    },
    "animations": false,
    "archives": {
      "extract": false,
      "create": false,
      "delete_backup": false,
      "compress": true,
      "create_dummies": true,
      "merge_incompressible": true,
      "merge_textures": false,
      "delete_sources": true
    }
  },
  "tree": {
    "content": [
      {
        "kind": "texture",
        "path": "mods/Mod/textures/reserved.dds",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64
      },
      {
        "kind": "texture",
        "path": "mods/Mod/textures/linked.dds",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64
      },
      {
        "kind": "texture",
        "path": "mods/Mod/textures/readonly.dds",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64,
        "note": "Read-only Loose Assets, a hard-linked one and a reserved device name: each is handled without touching what it shares or aliases."
      },
      {
        "kind": "texture",
        "path": "mods/Mod/textures/readonly.tga",
        "format": "R8G8B8A8_UNORM",
        "width": 64,
        "height": 64
      }
    ],
    "fs_shape": [
      {
        "op": "reserved_name",
        "path": "mods/Mod/textures/NUL.dds",
        "from": "mods/Mod/textures/reserved.dds"
      },
      {
        "op": "hardlink",
        "path": "store/linked.dds",
        "target": "mods/Mod/textures/linked.dds"
      },
      {
        "op": "readonly",
        "path": "mods/Mod/textures/readonly.dds"
      },
      {
        "op": "readonly",
        "path": "mods/Mod/textures/readonly.tga"
      }
    ]
  }
}

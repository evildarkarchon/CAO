// CAO's main window: a structural port of the C++ `src/MainWindow.ui` (#508), from the
// `prototype/slint-main-window` branch (#466).
//
// The settings each tab edits live in one global per tab (`BsaTab`, `MeshesTab`,
// `TexturesTab`, `AnimationsTab`), and the top rows and menu on `MainWindow`. Rust
// fills them from the profile's models and reads them back (`src/form.rs`).
//
// Slint has no enabled cascade: every tab-page control ANDs in `root.ed` (the run
// lock, #510) and its group's `checked` by hand. Text does not grey out by itself.

import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ListView, SpinBox, RadioGroup, Palette } from "std-widgets.slint";
import { TabInfo, CaoTabBar, CheckableGroupBox, ChoiceCheckBox, HelpArea, HelpCheckBox, HelpLabel, HelpRadio, DoubleSpinBox, CaoProgressBar, HelpTipLayer } from "widgets.slint";
import { TextInputDialog, ChoiceDialog, AboutSlintDialog } from "dialogs.slint";
import { FormatItem, FormatsDialog } from "dialogs.slint";

export { TabInfo, TextInputDialog, ChoiceDialog, AboutSlintDialog }
export { FormatItem, FormatsDialog }
// Exported so headless tests can place a tip where no help control reaches, such as
// the bottom edge (#512). The app itself never sets it from Rust.
export { HelpTip } from "widgets.slint";
import { LogPage } from "log.slint";
export { LogTab, LogRow, LogSeverity } from "log.slint";

// The BSA tab (`bsaTab`). `separate-*` are the C++ `bBsaCreate*` checkboxes, which
// show the inverse of `bBsaMerge*`.
export global BsaTab {
    in-out property <bool> extract;
    in-out property <bool> create;
    in-out property <bool> delete-backups;
    in-out property <bool> delete-source: true;
    in-out property <bool> create-dummies: true;
    in-out property <bool> compress: true;
    // The user's Work Choice (`bBsaMergeTexture`), which a game that forces the
    // checkbox (`RuleDisplay.separate-textures-forced`) never writes.
    in-out property <bool> separate-textures: true;
    in-out property <bool> separate-incompressible: true;
    // Advanced: the Archive Limit, the maximum uncompressed size in GB, and the
    // game as an index into `games`, the Game combo's items, which Rust builds
    // from the typed Profile model's game (`cao_archive::Game`).
    in-out property <float> archive-limit: 1.96;
    // Whether the Profile gives a maximum size. While it gives none, Rust's
    // rules (`rules.rs`) show the default of the game in the Game combo in `archive-limit`,
    // and the Profile is saved without a size; the user editing the spin box
    // gives one.
    in-out property <bool> archive-limit-given: true;
    // The Archive Size Cap: the most GB the game in the Game combo's Archives
    // may hold, or 0 for no cap: the BSA games stop at 2 GB. Rust's rules
    // (`rules.rs`) set it from the game.
    in property <float> archive-size-cap: 0;
    in-out property <int> game-index: 1;
    in property <[string]> games;
}

// The Meshes tab (`meshesTab`). `process` is the checkable "Process meshes" group.
export global MeshesTab {
    in-out property <bool> process: true;
    // The level radios, the user's level. Rust always sets all three, so they stay
    // exclusive even while the page (and the RadioGroup that keeps them exclusive)
    // does not exist. Several Mods shows Necessary without writing them (`RuleDisplay`).
    in-out property <bool> necessary: true;
    in-out property <bool> medium;
    in-out property <bool> full;
    in-out property <bool> headparts;
    in-out property <bool> resave;
    // Expert: indexes into the Version, User and Stream combos, whose items
    // (`versions`, `users`, `streams`) Rust builds from the typed Mesh Target.
    in-out property <int> version-index: 1;
    in-out property <int> user-index: 1;
    in-out property <int> stream-index: 2;
    in property <[string]> versions;
    in property <[string]> users;
    in property <[string]> streams;
}

// The Textures tab (`texturesTab`).
export global TexturesTab {
    in-out property <bool> process: true;
    in-out property <bool> necessary: true;
    in-out property <bool> compress;
    in-out property <bool> mipmaps;
    // The checkable "Downsizing" group, and which of its radios is checked:
    // 0 by ratio, 1 by fixed size, -1 neither (the `.ui` checks neither).
    in-out property <bool> resize: true;
    in-out property <int> resize-mode: -1;
    in-out property <int> ratio-height: 2;
    in-out property <int> ratio-width: 2;
    in-out property <int> size-height: 2048;
    in-out property <int> size-width: 2048;
    // Advanced. `output-format-index` indexes into `output-formats`, the Output
    // format combo's items, which Rust builds from the typed Texture Target
    // (`cao_profiles::TextureFormat`).
    in-out property <bool> tga-conversion;
    in-out property <int> output-format-index;
    in property <[string]> output-formats;
    in-out property <bool> compress-interface;
    in property <[string]> unwanted;
}

// The Animations tab (`AnimationsTab`).
export global AnimationsTab {
    in-out property <bool> necessary: true;
}

// What the window's rules force the controls to show. Rust's `rules.rs` is the
// one place the rules live: it sets these both when the user changes a control
// and when settings load. A forced control shows its forced state and is
// disabled, ANDed in with the run lock and its group. Every rule forces only
// what a control shows: the user's choice stays in its tab's global, which no
// rule writes, and shows again once the rule lifts.
export global RuleDisplay {
    // Admission Rules. A Profile Capability the Profile lacks holds back
    // Archive extraction or creation: Extract BSA, Create BSA and Delete
    // backups show unchecked.
    in property <bool> extract-forced-off;
    in property <bool> create-forced-off;
    in property <bool> delete-backups-forced-off;
    // Several Mods caps the Mesh level: the level radios show Necessary, with
    // Medium and Full disabled, while `MeshesTab` keeps the user's level.
    in property <bool> necessary-meshes-forced;
    // The Archive Rules display (#628). A game that keeps Textures in their own
    // Archive (FO4): "Separate textures BSA" shows checked.
    in property <bool> separate-textures-forced;
}

// The Meshes tab's three level radios, one exclusive RadioGroup, holding its
// own texts and help so every instance is the same set of radios to the user
// and to translators. `necessary`, `medium` and `full` are the radios' checked
// states, which the group writes itself; an instance binds them two-way to the
// user's level, or leaves them its own so that it writes nothing outside.
component MeshLevelRadios {
    in property <bool> enabled: true;
    // Whether Medium and Full may be chosen; false disables just those two.
    in property <bool> heavier-levels-enabled: true;
    in-out property <bool> necessary;
    in-out property <bool> medium;
    in-out property <bool> full;

    // RadioGroup has no settable selection index; programmatic selection
    // goes through each button's `checked`, and a plain `checked: expr`
    // binding is dropped on the first click. Two-way bindings survive.
    // The group resyncs them through change handlers, which run on the
    // next turn of the event loop.
    levels := RadioGroup {
        orientation: horizontal;
        enabled: root.enabled;
        RadioButton {
            text: @tr("Necessary optimization");
            checked <=> root.necessary;
            // The help overlay owns the pointer (shared tooltip layer,
            // help cursor, tips on a disabled radio); it forwards the
            // click by checking the radio, which the group then
            // selects. See `HelpArea` in widgets.slint.
            HelpArea {
                help: @tr("Attempts to repair meshes which are guaranteed to crash the game. Headparts are included.");
                clicked => {
                    if parent.enabled && levels.enabled {
                        root.necessary = true;
                    }
                }
            }
        }

        RadioButton {
            text: @tr("Medium optimization");
            enabled: root.heavier-levels-enabled;
            checked <=> root.medium;
            HelpArea {
                help: @tr("Perform necessary optimization, and also lightly optimizes other meshes. This may fix some visual issues, but may also lower quality.");
                clicked => {
                    if parent.enabled && levels.enabled {
                        root.medium = true;
                    }
                }
            }
        }

        RadioButton {
            text: @tr("Full optimization");
            enabled: root.heavier-levels-enabled;
            checked <=> root.full;
            HelpArea {
                help: @tr("Fully optimize all meshes. Only apply if standard mesh optimization ignored necessary files. May lower visual quality.");
                clicked => {
                    if parent.enabled && levels.enabled {
                        root.full = true;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("Cathedral Assets Optimizer");
    preferred-width: 676px;
    preferred-height: 700px;
    min-width: 600px;
    min-height: 520px;

    // ---- Profile and top rows
    in property <[string]> profiles;
    in-out property <int> profile-index;
    // Base profiles ship with CAO; their advanced groups are read-only.
    in property <bool> base-profile: true;
    in-out property <string> user-path;
    in-out property <bool> dry-run;
    in-out property <bool> show-advanced;
    // 0 One mod, 1 Several mods.
    in-out property <int> mode-index;
    in property <[TabInfo]> tabs;
    in-out property <string> current-tab: "bsa";

    // ---- Run state (driven from Rust by #510)
    in property <bool> running;
    in property <bool> cancelling;
    in property <bool> progress-indeterminate;
    in property <float> progress;
    in property <string> progress-text;
    in property <string> status-text;

    // ---- Menu state
    in-out property <bool> dark: true;
    in-out property <bool> debug-log;
    in-out property <bool> show-tutorials: true;

    // ---- Modal state: true while a Slint dialog is open over this window. The real
    // window is also disabled through winit; this blocks pointer input to the content
    // in-tree as well, so the headless tests see what a user sees.
    in property <bool> modal-blocked;

    // ---- Folder drop: true while Explorer drags something over the window (winit
    // `HoveredFile`), which shows the drop hint (#512).
    in property <bool> drop-hover;

    // Whether the std-widgets palette is dark: the whole window, menu bar included,
    // is drawn from it.
    out property <bool> palette-dark: Palette.color-scheme == ColorScheme.dark;

    callback profile-selected(int);
    callback new-profile();
    callback open-directory();
    callback run-clicked();
    callback mode-activated(int);
    callback advanced-clicked(bool);
    callback move-tab(int, int);
    callback edit-unwanted();
    callback debug-log-toggled(bool);
    callback open-log();
    callback open-docs();
    callback open-discord();
    callback about();
    callback about-slint();
    // A rule trigger (`rules.rs`), besides `mode-activated`.
    callback game-selected(int);

    // Qt's QTabWidget::setEnabled(false) disables every descendant. Slint has no enabled
    // cascade, so every control in the tab pages ANDs this in by hand.
    property <bool> ed: !root.running;
    // Advanced groups are read-only for base profiles (setAdvancedSettingsEnabled).
    property <bool> adv-ed: root.ed && !root.base-profile;

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    MenuBar {
        Menu {
            title: @tr("Tools");
            MenuItem {
                title: @tr("Enable dark theme");
                checkable: true;
                checked <=> root.dark;
            }

            MenuItem {
                title: @tr("Enable debug log");
                checkable: true;
                checked <=> root.debug-log;
                activated => {
                    root.debug-log-toggled(root.debug-log);
                }
            }

            MenuItem {
                title: @tr("Show tutorials");
                checkable: true;
                checked <=> root.show-tutorials;
            }

            MenuItem {
                title: @tr("Open log file");
                activated => {
                    root.open-log();
                }
            }
        }

        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Documentation");
                activated => {
                    root.open-docs();
                }
            }

            MenuItem {
                title: @tr("Discord");
                activated => {
                    root.open-discord();
                }
            }

            MenuItem {
                title: @tr("About");
                activated => {
                    root.about();
                }
            }

            MenuItem {
                title: @tr("About Slint");
                activated => {
                    root.about-slint();
                }
            }
        }
    }

    VerticalLayout {
        padding: 9px;
        padding-bottom: 0px;
        spacing: 6px;

        // groupBox: Profile | presets | New
        GroupBox {
            vertical-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: @tr("Profile");
                    vertical-alignment: center;
                }

                ComboBox {
                    accessible-label: @tr("Profile");
                    horizontal-stretch: 1;
                    model: root.profiles;
                    current-index <=> root.profile-index;
                    enabled: root.ed;
                    selected => {
                        root.profile-selected(self.current-index);
                    }
                }

                Button {
                    text: @tr("New");
                    enabled: root.ed;
                    clicked => {
                        root.new-profile();
                    }
                }
            }
        }

        // userPathTextEdit
        LineEdit {
            accessible-label: @tr("Mod folder");
            text <=> root.user-path;
            placeholder-text: @tr("Mod folder (or drop a folder onto the window)");
        }

        // mainGroupBox
        GroupBox {
            vertical-stretch: 0;
            GridLayout {
                spacing: 6px;
                Row {
                    Button {
                        text: @tr("Open Directory");
                        clicked => {
                            root.open-directory();
                        }
                    }

                    Button {
                        text: root.running ? @tr("Cancel") : @tr("Run");
                        primary: !root.running;
                        enabled: !root.cancelling;
                        clicked => {
                            root.run-clicked();
                        }
                    }

                    ComboBox {
                        accessible-label: @tr("Optimization mode");
                        model: [@tr("One mod"), @tr("Several mods")];
                        current-index <=> root.mode-index;
                        selected => {
                            root.mode-activated(self.current-index);
                        }
                    }
                }

                Row {
                    HelpCheckBox {
                        text: @tr("Dry run");
                        help: @tr("Will list all files that would be modified, without actually processing them. Will ignore files in BSAs.");
                        checked <=> root.dry-run;
                    }

                    Rectangle { }

                    CheckBox {
                        text: @tr("Show advanced settings");
                        checked <=> root.show-advanced;
                        toggled => {
                            root.advanced-clicked(self.checked);
                        }
                    }
                }
            }
        }

        // tabWidget
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            CaoTabBar {
                tabs: root.tabs;
                current-id <=> root.current-tab;
                enabled: root.ed;
                move-tab(from, to) => {
                    root.move-tab(from, to);
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;
                // A layout, not bare `if` children, so the active page's min-height reaches the window.
                VerticalLayout {

                    if root.current-tab == "bsa": VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        // A Profile without Archive support shows the three base
                        // options unchecked and disabled (`RuleDisplay`), and the
                        // group's title greys with them; the user's choices stay in
                        // `BsaTab`.
                        GroupBox {
                            title: @tr("Base");
                            enabled: root.ed && !(RuleDisplay.extract-forced-off && RuleDisplay.create-forced-off && RuleDisplay.delete-backups-forced-off);
                            HorizontalLayout {
                                spacing: 12px;
                                ChoiceCheckBox {
                                    text: @tr("Extract BSA");
                                    help: @tr("Extracts any BSAs present in the mod folder.");
                                    warning: @tr("Warning. If you enable this option, the process will be considerably slowed down.");
                                    enabled: root.ed;
                                    forced: RuleDisplay.extract-forced-off;
                                    forced-checked: false;
                                    checked <=> BsaTab.extract;
                                }

                                ChoiceCheckBox {
                                    text: @tr("Create BSA");
                                    help: @tr("Creates a new BSA, packing the existing loose files.");
                                    warning: @tr("Warning. If you enable this option, the process will be considerably slowed down.");
                                    enabled: root.ed;
                                    forced: RuleDisplay.create-forced-off;
                                    forced-checked: false;
                                    checked <=> BsaTab.create;
                                }

                                ChoiceCheckBox {
                                    text: @tr("Delete backups");
                                    help: @tr("By default, a backup of existing bsa is created. Enabling this option will disable those backups.");
                                    enabled: root.ed;
                                    forced: RuleDisplay.delete-backups-forced-off;
                                    forced-checked: false;
                                    checked <=> BsaTab.delete-backups;
                                }
                            }
                        }

                        GroupBox {
                            title: @tr("Extra");
                            enabled: root.ed;
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    HelpCheckBox {
                                        text: @tr("Delete source files");
                                        help: @tr("Whether CAO will delete the files it packed into BSAs or leave them.");
                                        enabled: root.ed;
                                        checked <=> BsaTab.delete-source;
                                    }

                                    HelpCheckBox {
                                        text: @tr("Create dummy plugins");
                                        help: @tr("Dummy plugins are almost always necessary. Disabling creation also removes existing Dummy Plugins whose bytes exactly match the selected game profile's canonical dummy content.");
                                        enabled: root.ed;
                                        checked <=> BsaTab.create-dummies;
                                    }

                                    HelpCheckBox {
                                        text: @tr("Allow compression");
                                        help: @tr("Compressed BSAs use less space on disk, but they might perform slightly worse in game");
                                        enabled: root.ed;
                                        checked <=> BsaTab.compress;
                                    }
                                }

                                Row {
                                    // The checkbox shows `forced || choice`. A game that keeps
                                    // Textures in their own Archive (FO4) forces it on (`RuleDisplay`).
                                    ChoiceCheckBox {
                                        text: @tr("Separate textures BSA");
                                        help: @tr("There are three types of BSAs CAO can create : incompressible, textures and standard. If enabled, this option will always separate textures into their own BSAs. Otherwise, they will be merged into the standard one if possible.");
                                        enabled: root.ed;
                                        forced: RuleDisplay.separate-textures-forced;
                                        forced-checked: true;
                                        checked <=> BsaTab.separate-textures;
                                    }

                                    HelpCheckBox {
                                        text: @tr("Separate incompressible BSA");
                                        help: @tr("There are three types of BSAs CAO can create : incompressible, textures and standard. If enabled, this option will always separate incompressible files into their own BSAs. Otherwise, they will be merged into the standard one if possible.");
                                        enabled: root.ed;
                                        checked <=> BsaTab.separate-incompressible;
                                    }
                                }
                            }
                        }

                        if root.show-advanced: GroupBox {
                            title: @tr("Advanced");
                            enabled: root.adv-ed;
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    HelpLabel {
                                        text: @tr("Maximum size");
                                        help: @tr("The maximum uncompressed size of the files in GB. Increasing it will increase the number of files stored per BSA, but you might reach the hard limit of BSA size, causing the game to crash.");
                                        enabled: root.adv-ed;
                                    }

                                    DoubleSpinBox {
                                        label: @tr("Maximum size");
                                        enabled: root.adv-ed;
                                        value <=> BsaTab.archive-limit;
                                        // `profile.ini` refuses a size of 0, so the box never offers one.
                                        minimum: 0.01;
                                        maximum: BsaTab.archive-size-cap > 0 ? BsaTab.archive-size-cap : 99.99;
                                        edited => {
                                            BsaTab.archive-limit-given = true;
                                        }
                                    }
                                }

                                Row {
                                    Text {
                                        text: @tr("Game");
                                        vertical-alignment: center;
                                    }

                                    ComboBox {
                                        accessible-label: @tr("Game");
                                        enabled: root.adv-ed;
                                        model: BsaTab.games;
                                        current-index <=> BsaTab.game-index;
                                        selected => {
                                            root.game-selected(self.current-index);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.current-tab == "meshes": VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        CheckableGroupBox {
                            title: @tr("Process meshes");
                            enabled: root.ed;
                            checked <=> MeshesTab.process;
                            // The level radios show the user's level (`MeshesTab`) or, while
                            // Several Mods caps it, Necessary with the heavier levels disabled
                            // (`RuleDisplay`). Two exclusive groups rather than one, as
                            // `ChoiceCheckBox` is two checkboxes: a RadioGroup writes its radios'
                            // `checked` itself (on a click, and to revert a disabled radio being
                            // checked, which it does while its group is unchecked), so a
                            // two-way binding to the user's level would let the forced level
                            // overwrite it. The forced group binds its radios to its own
                            // properties only, so it never writes `MeshesTab`. Both are one
                            // `MeshLevelRadios`, so the two stay one set of radios to the user
                            // and to translators.
                            HorizontalLayout {
                                if !RuleDisplay.necessary-meshes-forced: MeshLevelRadios {
                                    enabled: root.ed && MeshesTab.process;
                                    necessary <=> MeshesTab.necessary;
                                    medium <=> MeshesTab.medium;
                                    full <=> MeshesTab.full;
                                }

                                // Several Mods: Necessary, which is already checked, so its
                                // help overlay's click changes nothing; Medium and Full disabled.
                                if RuleDisplay.necessary-meshes-forced: MeshLevelRadios {
                                    enabled: root.ed && MeshesTab.process;
                                    heavier-levels-enabled: false;
                                    necessary: true;
                                }
                            }
                        }

                        GroupBox {
                            title: @tr("Advanced");
                            enabled: root.ed;
                            HorizontalLayout {
                                spacing: 12px;
                                HelpCheckBox {
                                    text: @tr("Always process headparts");
                                    help: @tr("When this option is disabled, headparts are ignored. It is recommended to keep it disabled when processing several mods.");
                                    enabled: root.ed;
                                    checked <=> MeshesTab.headparts;
                                }

                                HelpCheckBox {
                                    text: @tr("Resave meshes");
                                    help: @tr("Will resave meshes even if optimization is disabled. Will perform the same optimization as opening a mesh in NifSkope.");
                                    enabled: root.ed;
                                    checked <=> MeshesTab.resave;
                                }
                            }
                        }

                        if root.show-advanced: GroupBox {
                            title: @tr("Expert");
                            enabled: root.adv-ed;
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    Text {
                                        text: @tr("Version");
                                        vertical-alignment: center;
                                    }

                                    ComboBox {
                                        accessible-label: @tr("Version");
                                        enabled: root.adv-ed;
                                        model: MeshesTab.versions;
                                        current-index <=> MeshesTab.version-index;
                                    }
                                }

                                Row {
                                    Text {
                                        text: @tr("User");
                                        vertical-alignment: center;
                                    }

                                    ComboBox {
                                        accessible-label: @tr("User");
                                        enabled: root.adv-ed;
                                        model: MeshesTab.users;
                                        current-index <=> MeshesTab.user-index;
                                    }
                                }

                                Row {
                                    Text {
                                        text: @tr("Stream");
                                        vertical-alignment: center;
                                    }

                                    ComboBox {
                                        accessible-label: @tr("Stream");
                                        enabled: root.adv-ed;
                                        model: MeshesTab.streams;
                                        current-index <=> MeshesTab.stream-index;
                                    }
                                }
                            }
                        }
                    }

                    if root.current-tab == "textures": VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        CheckableGroupBox {
                            title: @tr("Process textures");
                            enabled: root.ed;
                            checked <=> TexturesTab.process;
                            HorizontalLayout {
                                spacing: 12px;
                                HelpCheckBox {
                                    text: @tr("Necessary optimization");
                                    help: @tr("Converts any TGA files into DDS, as SSE cannot read these. Attempts to convert and fix any textures that would crash the game, as some older formats are incompatible with SSE.");
                                    enabled: root.ed && TexturesTab.process;
                                    checked <=> TexturesTab.necessary;
                                }

                                HelpCheckBox {
                                    text: @tr("Compress textures");
                                    help: @tr("Compresses uncompressed textures to the configured output format. It is recommended for SSE and FO4, but may highly decrease quality for other games.");
                                    enabled: root.ed && TexturesTab.process;
                                    checked <=> TexturesTab.compress;
                                }

                                HelpCheckBox {
                                    text: @tr("Generate mipmaps");
                                    help: @tr("Recommended. Mipmaps are smaller copies of textures embedded in the same file which get used when things are small or far away and a pixel on screen covers several pixels in the texture. They improve visual quality with a small performance cost.");
                                    enabled: root.ed && TexturesTab.process;
                                    checked <=> TexturesTab.mipmaps;
                                }
                            }
                        }

                        CheckableGroupBox {
                            title: @tr("Downsizing");
                            enabled: root.ed;
                            checked <=> TexturesTab.resize;
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    HelpRadio {
                                        text: @tr("By ratio");
                                        help: @tr("Resizes textures, dividing the current width and height by the values given. Must result in texture dimensions expressed in powers of two, no less than 4x4.");
                                        enabled: root.ed && TexturesTab.resize;
                                        checked: TexturesTab.resize-mode == 0;
                                        clicked => {
                                            TexturesTab.resize-mode = 0;
                                        }
                                    }

                                    Text {
                                        text: @tr("Height:");
                                        vertical-alignment: center;
                                    }

                                    SpinBox {
                                        accessible-label: @tr("Height ratio");
                                        enabled: root.ed && TexturesTab.resize;
                                        minimum: 2;
                                        maximum: 10;
                                        value <=> TexturesTab.ratio-height;
                                    }

                                    Text {
                                        text: @tr("Width:");
                                        vertical-alignment: center;
                                    }

                                    SpinBox {
                                        accessible-label: @tr("Width ratio");
                                        enabled: root.ed && TexturesTab.resize;
                                        minimum: 2;
                                        maximum: 10;
                                        value <=> TexturesTab.ratio-width;
                                    }
                                }

                                Row {
                                    HelpRadio {
                                        text: @tr("By fixed size");
                                        help: @tr("Resizes texture dimensions to the given sizes. Must result in texture dimensions expressed in powers of two, no less than 4x4.");
                                        enabled: root.ed && TexturesTab.resize;
                                        checked: TexturesTab.resize-mode == 1;
                                        clicked => {
                                            TexturesTab.resize-mode = 1;
                                        }
                                    }

                                    Text {
                                        text: @tr("Height:");
                                        vertical-alignment: center;
                                    }

                                    SpinBox {
                                        accessible-label: @tr("Fixed height");
                                        enabled: root.ed && TexturesTab.resize;
                                        minimum: 4;
                                        maximum: 4096;
                                        value <=> TexturesTab.size-height;
                                    }

                                    Text {
                                        text: @tr("Width:");
                                        vertical-alignment: center;
                                    }

                                    SpinBox {
                                        accessible-label: @tr("Fixed width");
                                        enabled: root.ed && TexturesTab.resize;
                                        minimum: 4;
                                        maximum: 4096;
                                        value <=> TexturesTab.size-width;
                                    }
                                }
                            }
                        }

                        if root.show-advanced: GroupBox {
                            title: @tr("Advanced");
                            enabled: root.adv-ed;
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    HelpLabel {
                                        text: @tr("TGA");
                                        help: @tr("Will convert TGAs to a compatible DDS format if option is selected.");
                                        enabled: root.adv-ed;
                                    }

                                    CheckBox {
                                        colspan: 2;
                                        text: @tr("Enable TGA conversion");
                                        enabled: root.adv-ed;
                                        checked <=> TexturesTab.tga-conversion;
                                    }
                                }

                                Row {
                                    HelpLabel {
                                        text: @tr("Output format");
                                        help: @tr("Output format for uncompressed textures, modified textures, and converted TGA files. BC7 should only be used for SSE or FO4.");
                                        enabled: root.adv-ed;
                                    }

                                    ComboBox {
                                        colspan: 2;
                                        accessible-label: @tr("Output format");
                                        enabled: root.adv-ed;
                                        model: TexturesTab.output-formats;
                                        current-index <=> TexturesTab.output-format-index;
                                    }
                                }

                                Row {
                                    HelpLabel {
                                        text: @tr("Interface");
                                        help: @tr("Some games do not support compressed interface textures.");
                                        enabled: root.adv-ed;
                                    }

                                    CheckBox {
                                        colspan: 2;
                                        text: @tr("Compress interface textures");
                                        enabled: root.adv-ed;
                                        checked <=> TexturesTab.compress-interface;
                                    }
                                }

                                Row {
                                    HelpLabel {
                                        text: @tr("Unwanted formats");
                                        help: @tr("Textures using these formats will be converted to a supported format.");
                                        enabled: root.adv-ed;
                                    }

                                    // texturesUnwantedFormatsList: read-only here; the Edit
                                    // dialog changes it.
                                    Rectangle {
                                        height: 84px;
                                        horizontal-stretch: 1;
                                        border-width: 1px;
                                        border-radius: 3px;
                                        border-color: Palette.border;
                                        accessible-role: list;
                                        accessible-label: @tr("Unwanted formats");
                                        accessible-enabled: root.adv-ed;
                                        accessible-item-count: TexturesTab.unwanted.length;
                                        ListView {
                                            for name in TexturesTab.unwanted: Text {
                                                text: name;
                                                height: 20px;
                                                x: 6px;
                                                vertical-alignment: center;
                                                color: root.adv-ed ? Palette.foreground : Palette.foreground.transparentize(0.55);
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: start;
                                        Button {
                                            text: @tr("Edit");
                                            enabled: root.adv-ed;
                                            clicked => {
                                                root.edit-unwanted();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.current-tab == "animations": VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        GroupBox {
                            title: @tr("Process animations");
                            enabled: root.ed;
                            HelpCheckBox {
                                text: @tr("Necessary optimization");
                                help: @tr("Converts animations to the appropriate format. If an animation is already compatible, no change will be made.");
                                enabled: root.ed;
                                checked <=> AnimationsTab.necessary;
                            }
                        }

                        // Empty, as it was in MainWindow.ui; nothing fills it yet.
                        if root.show-advanced: GroupBox {
                            title: @tr("Advanced");
                            enabled: root.adv-ed;
                            Rectangle {
                                height: 16px;
                            }
                        }
                    }

                    // The Log tab's page, filled from the Application Log feed (#511).
                    if root.current-tab == "log": LogPage { }
                }
            }
        }

        // progressBar: QProgressBar draws its format text inside the bar.
        CaoProgressBar {
            label: @tr("Progress");
            indeterminate: root.progress-indeterminate;
            progress: root.progress;
            text: root.progress-text;
        }

        // QMainWindow::statusBar()
        Rectangle {
            height: 22px;
            Text {
                x: 2px;
                text: root.status-text;
                vertical-alignment: center;
                font-size: 11px;
                color: Palette.foreground.transparentize(0.25);
            }
        }
    }

    // Swallows pointer input to the content while a modal dialog is open. Declared
    // after the content so it is on top; the menu bar is outside it, and the real
    // window is disabled through winit anyway.
    if root.modal-blocked: TouchArea { }

    // The drop hint. No TouchArea: the drag is an OS one that Slint's pointer
    // handling never sees, so there is nothing to intercept.
    if root.drop-hover: Rectangle {
        background: Palette.accent-background.with-alpha(0.18);
        border-width: 3px;
        border-color: Palette.accent-background;
        Text {
            text: @tr("Drop a folder to set the mod path");
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HelpTipLayer {
        width: 100%;
        height: 100%;
    }
}

// The window's modal Slint dialogs (#508). Rust opens and closes them through
// `modal.rs`, which owns the owner window, the depth-counted guard and the deferred
// teardown; these components only raise `confirm` and `dismiss`.
//
// Each is a plain Window holding its own OK and Cancel buttons rather than a
// Dialog with StandardButtons (GUI-5). Escape dismisses a dialog, and a key reaches
// a handler only by bubbling up from the focused control through its ancestors: a
// Dialog's StandardButtons sit beside its content, so Escape pressed on a button
// would reach no handler. Here one disabled FocusScope (`DialogKeys`) wraps the
// content and the buttons; disabled, it is no Tab stop, yet Slint still hands it the
// keys its children reject. Each dialog focuses a control on opening, so Escape works
// before the first Tab or click.
//
// Gotcha (#466): a Window's `title` must be re-exposed as an `in` property to be set
// from Rust.

import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView } from "std-widgets.slint";

// Wraps a dialog's content and buttons; raises `escape` for an Escape no child took.
component DialogKeys inherits FocusScope {
    callback escape();

    enabled: false;
    key-pressed(event) => {
        if event.text == Key.Escape {
            root.escape();
            return accept;
        }
        return reject;
    }
}

// The OK and Cancel row at the bottom right of a dialog, as Windows lays it out.
component OkCancel inherits HorizontalLayout {
    callback confirm();
    callback dismiss();

    alignment: end;
    spacing: 6px;
    Button {
        text: @tr("OK");
        primary: true;
        clicked => {
            root.confirm();
        }
    }

    Button {
        text: @tr("Cancel");
        clicked => {
            root.dismiss();
        }
    }
}

// QInputDialog::getText
export component TextInputDialog inherits Window {
    in property <string> dialog-title;
    title: root.dialog-title;
    preferred-width: 320px;
    in property <string> label;
    in-out property <string> value;
    // Why the last confirmed value was refused; empty while there is none. The
    // dialog stays open so the user can correct the value in place.
    in property <string> error;
    callback confirm();
    callback dismiss();

    init => {
        le.focus();
    }

    DialogKeys {
        escape => {
            root.dismiss();
        }

        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text {
                text: root.label;
            }

            le := LineEdit {
                accessible-label: root.label;
                text <=> root.value;
                accepted => {
                    root.confirm();
                }
            }

            if root.error != "": Text {
                text: root.error;
                wrap: word-wrap;
                color: #c42b1c;
                accessible-role: text;
            }

            OkCancel {
                confirm => {
                    root.confirm();
                }
                dismiss => {
                    root.dismiss();
                }
            }
        }
    }
}

// QInputDialog::getItem
export component ChoiceDialog inherits Window {
    in property <string> dialog-title;
    title: root.dialog-title;
    preferred-width: 320px;
    in property <string> label;
    in property <[string]> choices;
    in-out property <int> current-index;
    callback confirm();
    callback dismiss();

    init => {
        combo.focus();
    }

    DialogKeys {
        escape => {
            root.dismiss();
        }

        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text {
                text: root.label;
            }

            combo := ComboBox {
                accessible-label: root.label;
                model: root.choices;
                current-index <=> root.current-index;
            }

            OkCancel {
                confirm => {
                    root.confirm();
                }
                dismiss => {
                    root.dismiss();
                }
            }
        }
    }
}

// One row of the unwanted-formats dialog.
export struct FormatItem {
    name: string,
    checked: bool,
}

// TexturesFormatSelectDialog (#509). Qt's title is literally "Dialog"; this one is
// titled (an accepted visual deviation). Rust hands it a filter model over a scratch
// copy of the formats: each checkbox's two-way binding writes through the filter to
// the scratch row, so the search hides rows without losing their checked state. OK
// commits the scratch copy; Cancel, Escape and the title bar discard it (deviation 2).
//
// The list scrolls, so the dialog asks only for a height that fits, with its title
// bar, the work area of a 1366×768 screen or of a 1920×1080 one at 150% (GUI-6). It
// once asked for 742px, which neither has room for.
export component FormatsDialog inherits Window {
    title: @tr("Unwanted formats");
    preferred-width: 320px;
    preferred-height: 480px;

    in property <[FormatItem]> items;
    in-out property <string> search;
    callback search-edited(string);
    callback confirm();
    callback dismiss();

    init => {
        search-box.focus();
    }

    DialogKeys {
        escape => {
            root.dismiss();
        }

        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            Text {
                text: @tr("Search");
            }

            search-box := LineEdit {
                accessible-label: @tr("Search");
                text <=> root.search;
                edited(text) => {
                    root.search-edited(text);
                }
            }

            Rectangle {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: @tr("Formats");
                accessible-item-count: root.items.length;
                ListView {
                    for item in root.items: CheckBox {
                        text: item.name;
                        checked <=> item.checked;
                    }
                }
            }

            OkCancel {
                confirm => {
                    root.confirm();
                }
                dismiss => {
                    root.dismiss();
                }
            }
        }
    }
}

// Replaces QMessageBox::aboutQt. Escape closes it as OK does.
export component AboutSlintDialog inherits Window {
    title: @tr("About Slint");
    callback confirm();

    init => {
        ok.focus();
    }

    DialogKeys {
        escape => {
            root.confirm();
        }

        VerticalLayout {
            padding: 9px;
            spacing: 6px;
            AboutSlint { }

            HorizontalLayout {
                alignment: end;
                ok := Button {
                    text: @tr("OK");
                    primary: true;
                    clicked => {
                        root.confirm();
                    }
                }
            }
        }
    }
}
